# ai-house-v3
# LLM: yandex (активно) | openai (ChatGPT, Responses API)
LLM_PROVIDER=yandex

# Yandex AI (Responses API)
YANDEX_API_KEY=
YANDEX_CATALOG_ID=
YANDEX_MODEL=yandexgpt/rc

# OpenAI / ChatGPT (Responses API; включить LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# MCP (URL сервисов auth-mcp и sms-mcp)
MCP_AUTH_URL=http://auth-mcp:8000/mcp
MCP_SMS_URL=http://sms-mcp:8000/mcp

# Postgres для MCP-сервисов (не для агента)
POSTGRES_MCP_DSN_MAIN=postgresql://user:password@host.docker.internal:5432/main_db
POSTGRES_MCP_DSN_AUTH=postgresql://auth_user:auth_password@host.docker.internal:5434/auth_db

LOG_LEVEL=INFO

# Dev: перечитывать prompt.md без перезапуска
APP_RELOAD=1

# Таймаут одного запроса к БД через MCP, в секундах
DB_QUERY_TIMEOUT_SECONDS=5
