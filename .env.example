# ai-house-v3
LLM_PROVIDER=yandex

# Yandex AI
YANDEX_API_KEY=
YANDEX_CATALOG_ID=
YANDEX_MODEL=yandexgpt-lite

# Orchestration
GRAPH_SUPERVISOR_MAX_STEPS=6
AGENT_DB_ENABLED=true
MCP_AUTH_URL=http://auth-mcp:8000/mcp
MCP_SMS_URL=http://sms-mcp:8000/mcp

# MCP-owned Postgres sources (used by separate auth-mcp/sms-mcp services)
POSTGRES_MCP_DSN_MAIN=postgresql://user:password@host.docker.internal:5432/main_db
POSTGRES_MCP_DSN_BILLING=postgresql://user:password@host.docker.internal:5432/billing_db
# Auth DB (public.users — отдельный MCP/DSN от SMS)
POSTGRES_MCP_DSN_AUTH=postgresql://auth_user:auth_password@host.docker.internal:5434/auth_db

# Логи (сценарии, шаги к БД)
LOG_LEVEL=INFO

# Макс. раундов LLM→MCP внутри одного шага db (промпт-only исполнитель)
DB_EXECUTOR_MAX_ROUNDS=8

# Таймаут одного запроса к БД через MCP, в секундах
DB_QUERY_TIMEOUT_SECONDS=5
