# ai-house-v3
LLM_PROVIDER=yandex

# Yandex AI
YANDEX_API_KEY=
YANDEX_CATALOG_ID=
YANDEX_MODEL=yandexgpt-lite

# Orchestration
GRAPH_SUPERVISOR_MAX_STEPS=6
AGENT_DB_ENABLED=true

# Multi-Postgres sources (read-only investigation)
POSTGRES_MCP_DSN_MAIN=postgresql://user:password@host.docker.internal:5432/main_db
POSTGRES_MCP_DSN_BILLING=postgresql://user:password@host.docker.internal:5432/billing_db
